{
  "expo": {
    "name": "Vehdoc",
    "slug": "vehdoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1e3a5f",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vehdoc.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f"
      },
      "package": "com.vehdoc.app"
    },
    "plugins": [
      "expo-notifications",
      "expo-image-picker",
      "expo-document-picker",
      "expo-secure-store"
    ]
  }
}
